# These will be automatically created by Neon Launchpad (https://neon.new).
DATABASE_URL=
DATABASE_URL_POOLER=

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# GitHub OAuth App — https://github.com/settings/developers
# Homepage URL:           http://localhost:3000
# Authorization callback:  http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# Embedding — "qwen" (local, via Ollama) or "openai"
EMBEDDING_PROVDIER=qwen
LOCAL_EMBEDDING_BASE_URL=http://localhost:11434
# Required only when EMBEDDING_PROVDIER=openai
OPENAI_API_KEY=